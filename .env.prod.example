# ── Production secrets template ────────────────────────────────────────────
# Copy this file to .env.prod on your EC2 instance and fill in real values.
# NEVER commit .env.prod to git.
#
#   cp .env.prod.example .env.prod
#   nano .env.prod

# Strong random passwords (generate with: openssl rand -base64 24)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_PASSWORD=CHANGE_ME_app_password
